<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sdk="clr-namespace:MioKit.Sdk;assembly=MioKit.Sdk"
             x:Class="EverythingSearch.Views.EverythingCompactResultItem"
             x:DataType="sdk:SearchResult"
             Height="26"
             MinHeight="26"
             MaxHeight="26"
             Background="Transparent">
  <Grid ColumnDefinitions="20,*"
        Margin="8,0,8,0"
        VerticalAlignment="Center">
    <Image x:Name="IconImage"
           Grid.Column="0"
           Width="16"
           Height="16"
           Stretch="Uniform"
           VerticalAlignment="Center"
           HorizontalAlignment="Left" />

    <Grid Grid.Column="1"
          ColumnDefinitions="*,Auto"
          Margin="6,0,0,0"
          VerticalAlignment="Center">
      <TextBlock Grid.Column="0"
                 Text="{Binding Title}"
                 FontSize="12"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource ShadForegroundBrush}" />
      <TextBlock Grid.Column="1"
                 Text="{Binding Description}"
                 FontSize="11"
                 Margin="12,0,0,0"
                 Opacity="0.65"
                 TextTrimming="CharacterEllipsis"
                 TextWrapping="NoWrap"
                 VerticalAlignment="Center"
                 MaxWidth="360"
                 Foreground="{DynamicResource ShadMutedForegroundBrush}" />
    </Grid>
  </Grid>
</UserControl>
